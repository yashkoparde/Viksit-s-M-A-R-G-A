{
  "name": "mplads-monitoring-platform",
  "version": "1.0.0",
  "description": "MPLADS Monitoring, Analytics, Geotagged Inspection and Verification Platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "node src/server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:5000",
    "tunnel:lt": "npx localtunnel --port 5000",
    "dev:public": "concurrently -k \"npm run dev\" \"npm run tunnel\"",
    "seed": "node src/scripts/seedData.js",
    "import-data": "node src/scripts/importOfficialData.js"
  },
  "keywords": [
    "mplads",
    "governance",
    "analytics",
    "geotagging",
    "monitoring",
    "mospi",
    "hackathon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
